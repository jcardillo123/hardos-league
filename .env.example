# Copy this file to .env and fill in your values. Never commit .env.
#
# ESPN_LEAGUE_ID  digits only, from your league URL
# ESPN_S2         only needed for PRIVATE leagues; very long, ~250-400 chars
# ESPN_SWID       only needed for PRIVATE leagues; keep the curly braces
# ODDS_API_KEY    the-odds-api.com key, for Vegas lines. Optional.
#
# Values are quoted because espn_s2 can contain % and # characters, and an
# unquoted # would start a comment and silently truncate the token.

ESPN_LEAGUE_ID=123456
ESPN_S2="AEB...paste the whole thing on one line..."
ESPN_SWID="{XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"

# The Odds API meters every request. tools/odds_probe.py will not spend a single
# credit without an explicit --spend flag.
ODDS_API_KEY="your32characterkeyfromtheoddsapi"
